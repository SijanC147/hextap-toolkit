  local context state state_descr line
  typeset -A opt_args
  _arguments -s -S \
    '(-h --help)-h[Print this complete command help and exit successfully without performing any work.]' \
    '(-h --help)--help[Print this complete command help and exit successfully without performing any work.]'
}

_hextap_completion() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -C \
    '(-h --help)-h[Print this complete command help and exit successfully without performing any work.]' \
    '(-h --help)--help[Print this complete command help and exit successfully without performing any work.]' \
    '1:command:->command' \
    '*::argument:->arguments'
  case "$state" in
    command)
      local -a commands
      commands=(
        'zsh:Print the native Zsh completion definition'
      )
      _describe 'command' commands
      ;;
    arguments)
      case "${line[1]}" in
        zsh) _hextap_completion_zsh ;;
      esac
      ;;
  esac
}

_hextap() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -C \
    '(-h --help)-h[Print this complete command help and exit successfully without performing any work.]' \
    '(-h --help)--help[Print this complete command help and exit successfully without performing any work.]' \
    '(-V --version)-V[Print the installed Hextap version and exact source commit, then exit successfully.]' \
    '(-V --version)--version[Print the installed Hextap version and exact source commit, then exit successfully.]' \
    '1:command:->command' \
    '*::argument:->arguments'
  case "$state" in
    command)
      local -a commands
      commands=(
        'version:Print the installed build version and source commit'
        'onboard:Plan or create deterministic local Hextap onboarding artifacts'
        'validate:Validate local onboarding artifacts and optionally smoke-build archives'
        'doctor:Check local prerequisites and optionally inspect GitHub read-only'
        'skills:Inspect and manage bundled Hextap agent skills'
        'dev:Develop, validate, release, and install Hextap itself'
        'completion:Generate native shell completion definitions'
      )
      _describe 'command' commands
      ;;
    arguments)
      case "${line[1]}" in
        version) _hextap_version ;;
        onboard) _hextap_onboard ;;
        validate) _hextap_validate ;;
        doctor) _hextap_doctor ;;
        skills) _hextap_skills ;;
        dev) _hextap_dev ;;
        completion) _hextap_completion ;;
      esac
      ;;
  esac
}

_hextap "$@"
