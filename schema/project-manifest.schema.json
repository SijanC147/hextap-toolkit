{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SijanC147/hextap-toolkit/schema/project-manifest.schema.json",
  "title": "Hextap project manifest",
  "description": "Declarative project metadata consumed by hextapctl. Schema 1 preserves Go archives; schema 2 adds a pinned Bun profile, explicit targets, optional Windows amd64, and a tap-owned Formula profile. Go validation remains authoritative for cross-field identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "formula",
    "release",
    "homebrew"
  ],
  "properties": {
    "schema": {
      "oneOf": [
        {
          "const": 1
        },
        {
          "const": 2
        }
      ]
    },
    "formula": {
      "$ref": "#/$defs/formula"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "homebrew": {
      "$ref": "#/$defs/homebrew"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": 1
            },
            "release": {
              "$ref": "#/$defs/releaseLegacy"
            },
            "homebrew": {
              "$ref": "#/$defs/homebrewLegacy"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": 2
            },
            "release": {
              "$ref": "#/$defs/releaseProfileContract"
            },
            "homebrew": {
              "$ref": "#/$defs/homebrewProfile"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "formulaName": {
      "type": "string",
      "maxLength": 235,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z][a-z0-9]*)*$"
    },
    "className": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "repositoryName": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "repositoryOwner": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$"
    },
    "fileName": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "assetName": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*\\.tar\\.gz$"
    },
    "relativePath": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*(?:/[A-Za-z0-9][A-Za-z0-9._+-]*)*$"
    },
    "environmentKey": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "argument": {
      "type": "string",
      "pattern": "^[-A-Za-z0-9_./:=+,%@]+$"
    },
    "commandName": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "commandArgument": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1F]+$"
    },
    "runtimeVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "rubyLine": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\"\\\\]"
          }
        },
        {
          "not": {
            "pattern": "[\\x00-\\x1F]"
          }
        },
        {
          "not": {
            "pattern": "#(?:\\{|@|\\$)"
          }
        },
        {
          "not": {
            "pattern": "^[ \\t\\r\\n]*$"
          }
        }
      ]
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
    },
    "environmentValue": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "[\"\\\\]"
          }
        },
        {
          "not": {
            "pattern": "[\\x00\\r\\n]"
          }
        },
        {
          "not": {
            "pattern": "#(?:\\{|@|\\$)"
          }
        }
      ]
    },
    "caveats": {
      "type": "string",
      "allOf": [
        {
          "not": {
            "pattern": "#(?:\\{|@|\\$)"
          }
        },
        {
          "not": {
            "pattern": "[\\x00\\r]"
          }
        },
        {
          "not": {
            "pattern": "(^|\\n)[ \\t]*EOS[ \\t]*(\\n|$)"
          }
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "name"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/repositoryOwner"
        },
        "name": {
          "$ref": "#/$defs/repositoryName"
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Go validation additionally requires the two asset basenames to be different.",
      "additionalProperties": false,
      "required": [
        "darwin_arm64",
        "darwin_amd64"
      ],
      "properties": {
        "darwin_arm64": {
          "$ref": "#/$defs/assetName"
        },
        "darwin_amd64": {
          "$ref": "#/$defs/assetName"
        }
      }
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "class",
        "description",
        "homepage",
        "license",
        "repository",
        "binary",
        "assets"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/formulaName"
        },
        "class": {
          "$ref": "#/$defs/className"
        },
        "description": {
          "$ref": "#/$defs/rubyLine"
        },
        "homepage": {
          "$ref": "#/$defs/homepage"
        },
        "license": {
          "$ref": "#/$defs/rubyLine"
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "binary": {
          "$ref": "#/$defs/fileName"
        },
        "assets": {
          "$ref": "#/$defs/assets"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_script"
      ],
      "properties": {
        "build_script": {
          "$ref": "#/$defs/relativePath"
        },
        "linux": {
          "type": "boolean"
        },
        "profile": {
          "$ref": "#/$defs/releaseProfile"
        },
        "targets": {
          "$ref": "#/$defs/releaseTargets"
        }
      }
    },
    "releaseLegacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_script",
        "linux"
      ],
      "properties": {
        "build_script": {
          "$ref": "#/$defs/relativePath"
        },
        "linux": {
          "type": "boolean"
        }
      }
    },
    "releaseProfileContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_script",
        "profile",
        "targets"
      ],
      "properties": {
        "build_script": {
          "$ref": "#/$defs/relativePath"
        },
        "profile": {
          "$ref": "#/$defs/releaseProfile"
        },
        "targets": {
          "$ref": "#/$defs/releaseTargets"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "argv"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/commandName"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/commandArgument"
          }
        }
      }
    },
    "releaseProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "runtime_version",
        "install",
        "quality",
        "prepare"
      ],
      "properties": {
        "runtime": {
          "const": "bun"
        },
        "runtime_version": {
          "$ref": "#/$defs/runtimeVersion"
        },
        "install": {
          "$ref": "#/$defs/command"
        },
        "quality": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "prepare": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    "targetArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binary": {
          "$ref": "#/$defs/fileName"
        },
        "archive": {
          "$ref": "#/$defs/assetName"
        },
        "archive_contents": {
          "oneOf": [
            {
              "const": "binary"
            },
            {
              "const": "bundle"
            }
          ]
        }
      }
    },
    "releaseTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "darwin_arm64",
        "darwin_amd64"
      ],
      "properties": {
        "darwin_arm64": {
          "$ref": "#/$defs/targetArtifacts"
        },
        "darwin_amd64": {
          "$ref": "#/$defs/targetArtifacts"
        },
        "linux_arm64": {
          "$ref": "#/$defs/targetArtifacts"
        },
        "linux_amd64": {
          "$ref": "#/$defs/targetArtifacts"
        },
        "windows_amd64": {
          "$ref": "#/$defs/targetArtifacts"
        }
      }
    },
    "keepAliveSuccessfulExit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successful_exit"
      ],
      "properties": {
        "successful_exit": {
          "type": "boolean"
        }
      }
    },
    "keepAliveCrashed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crashed"
      ],
      "properties": {
        "crashed": {
          "type": "boolean"
        }
      }
    },
    "keepAlive": {
      "oneOf": [
        {
          "$ref": "#/$defs/keepAliveSuccessfulExit"
        },
        {
          "$ref": "#/$defs/keepAliveCrashed"
        }
      ]
    },
    "serviceDisabled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "const": false
        }
      }
    },
    "serviceEnabled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "run_args",
        "keep_alive",
        "restart_delay",
        "environment",
        "log_path",
        "error_log_path"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "run_args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "keep_alive": {
          "$ref": "#/$defs/keepAlive"
        },
        "restart_delay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/environmentKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/environmentValue"
          }
        },
        "log_path": {
          "$ref": "#/$defs/relativePath"
        },
        "error_log_path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "service": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/serviceDisabled"
        },
        {
          "$ref": "#/$defs/serviceEnabled"
        }
      ]
    },
    "homebrew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macos_only",
        "test_args"
      ],
      "properties": {
        "macos_only": {
          "const": true
        },
        "test_args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "caveats": {
          "$ref": "#/$defs/caveats"
        },
        "formula_profile": {
          "$ref": "#/$defs/formulaName"
        },
        "service_enabled": {
          "type": "boolean"
        }
      }
    },
    "homebrewLegacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macos_only",
        "test_args",
        "caveats"
      ],
      "properties": {
        "macos_only": {
          "const": true
        },
        "test_args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "caveats": {
          "$ref": "#/$defs/caveats"
        }
      }
    },
    "homebrewProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macos_only",
        "test_args",
        "formula_profile",
        "service_enabled"
      ],
      "properties": {
        "macos_only": {
          "const": true
        },
        "test_args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "formula_profile": {
          "$ref": "#/$defs/formulaName"
        },
        "service_enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
